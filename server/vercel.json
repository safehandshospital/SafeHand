{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npx prisma generate",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/.prisma/client/**",
          "node_modules/@prisma/client/**",
          "prisma/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.ts" }]
}
